# Node environment
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://kampi:kampi_dev@localhost:5432/kampi?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=dev-only-change-in-production-use-32-chars-min
DEV_GUEST_AUTH_ENABLED=true

# Public origins (no trailing slash)
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
API_PUBLIC_URL=http://localhost:4000
REALTIME_PUBLIC_URL=ws://localhost:2567
GAME_RPS_PUBLIC_URL=http://localhost:5173
GAME_PENALTY_PUBLIC_URL=http://localhost:5174

# Economy defaults (prototype)
STARTING_CHIPS=10000
RPS_ENTRY_FEE=500
RPS_WINNER_PAYOUT=950
PENALTY_ENTRY_FEE=500
PENALTY_WINNER_PAYOUT=950
BOT_FILL_AFTER_MS=10000
RECONNECT_GRACE_MS=30000

# Ports (optional overrides)
API_PORT=4000
REALTIME_PORT=2567
WEB_PORT=3000
ADMIN_PORT=3001
