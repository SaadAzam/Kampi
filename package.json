{
  "name": "kampi",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --concurrency=25 --filter=./apps/*",
    "dev:all": "turbo run dev --parallel --concurrency=25",
    "dev:reset": "bash scripts/restart-dev.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @kampi/e2e test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @kampi/database db:generate",
    "db:migrate": "pnpm --filter @kampi/database db:migrate",
    "db:seed": "pnpm --filter @kampi/database db:seed",
    "db:push": "pnpm --filter @kampi/database db:push",
    "postinstall": "node scripts/patch-colyseus-greeting.mjs"
  },
  "devDependencies": {
    "@kampi/config": "workspace:*",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3": "3.3.18",
      "postcss@<8.5.23": "8.5.26",
      "deepmerge-ts@<8": "8.0.0",
      "@colyseus/core>@colyseus/greeting-banner": "4.0.2"
    },
    "patchedDependencies": {
      "@colyseus/core@0.16.25": "patches/@colyseus__core@0.16.25.patch"
    }
  }
}
